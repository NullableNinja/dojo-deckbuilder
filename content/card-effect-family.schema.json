{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nullableninja.github.io/dojo-deckbuilder/schema/card-effect-family.schema.json",
  "title": "Dojo Deckbuilder Card Effect Family Registry",
  "description": "Canonical authoring container for one card family's structured effects. Individual effects follow card-effect.schema.json and should reference content/effects.json through their effect field.",
  "type": "object",
  "required": ["schemaVersion", "rulesVersion", "rulesRevision", "family", "cards"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "rulesVersion": { "type": "string", "minLength": 1 },
    "rulesRevision": { "type": "string", "minLength": 1 },
    "family": {
      "enum": ["Starter", "Attack", "Defense", "Kata", "Consumable", "Equipment", "Combo", "Location", "Character"]
    },
    "description": { "type": "string" },
    "cards": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "effects"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "effects": {
            "type": "array",
            "items": { "$ref": "card-effect.schema.json" }
          }
        }
      }
    }
  }
}
