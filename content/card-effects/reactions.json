{"$schema":"../card-effect-family.schema.json","schemaVersion":1,"rulesVersion":"v2.3","rulesRevision":"v2.3-r5","family":"Reaction Item","description":"Canonical structured timing and resolver contracts for every Core Reaction Item. The generic Reaction host owns timing windows, player selection, AI selection, source destruction, and follow-up lifecycle; the resolvers below declare the card-specific semantic plan without teaching Playtest card identity.","cards":{"DDB-RIT-CORE-001":{"name":"Caution: Wet Floor","effects":[{"id":"reaction-wet-floor-declared-low-penalty","effect":"core.custom","trigger":"onAttackDeclared","target":"opponent","amount":-3,"resolver":"reaction.reduceDeclaredAttackPower","conditions":[{"kind":"incomingAttackTargetsSelf"},{"kind":"incomingZones","value":["Low"]}]}]},"DDB-RIT-CORE-002":{"name":"Disposable Elbow Pad","effects":[{"id":"reaction-elbow-pad-damage-prevention","effect":"core.custom","trigger":"onAttackDeclared","target":"self","amount":3,"resolver":"reaction.preventIncomingDamage","conditions":[{"kind":"incomingAttackTargetsSelf"},{"kind":"incomingZones","value":["High","Mid"]}]}]},"DDB-RIT-CORE-003":{"name":"Dojo Folding Mat","effects":[{"id":"reaction-folding-mat-defense","effect":"core.custom","trigger":"onAttackDeclared","target":"self","amount":4,"resolver":"reaction.defenseAgainstIncomingAttack","conditions":[{"kind":"incomingAttackTargetsSelf"},{"kind":"incomingZones","value":["Low","Mid"]}]}]},"DDB-RIT-CORE-004":{"name":"Emergency Coupon Override","effects":[{"id":"reaction-coupon-override-market-discount","effect":"core.custom","trigger":"passive","target":"self","resolver":"reaction.preserveMarketDiscount"}]},"DDB-RIT-CORE-005":{"name":"Instant Noodle Smokescreen","effects":[{"id":"reaction-noodle-smokescreen-out-of-turn-consumable","effect":"core.custom","trigger":"onPlay","target":"self","resolver":"reaction.outOfTurnConsumableShield","conditions":[{"kind":"defenseOutsideTurn"}]}]},"DDB-RIT-CORE-006":{"name":"Official Time-Out Card","effects":[{"id":"reaction-time-out-cancel-combo-payoff","effect":"core.custom","trigger":"passive","target":"opponent","resolver":"reaction.cancelComboPayoff"}]},"DDB-RIT-CORE-007":{"name":"Parking Validation Stub","effects":[{"id":"reaction-validation-stub-prevent-forced-discard","effect":"core.custom","trigger":"passive","target":"self","resolver":"reaction.preventForcedDiscard","conditions":[{"kind":"forcedDiscardEvent"}]}]},"DDB-RIT-CORE-008":{"name":"Pocket-Sand Receipt","effects":[{"id":"reaction-pocket-sand-receipt-force-draw-discard","effect":"core.custom","trigger":"onAttackDeclared","target":"opponent","resolver":"reaction.forceAttackerDrawDiscardBeforeDefense","conditions":[{"kind":"incomingAttackTargetsSelf"},{"kind":"incomingZones","value":["High"]}]}]},"DDB-RIT-CORE-009":{"name":"Pop-Up Safety Seminar","effects":[{"id":"reaction-safety-seminar-defense-exam-credit","effect":"core.custom","trigger":"onDefenseDeclared","target":"self","resolver":"reaction.defenseBeltExamCredit"}]},"DDB-RIT-CORE-010":{"name":"Temporary Tattoo Pass","effects":[{"id":"reaction-tattoo-pass-block-followup","effect":"core.custom","trigger":"onBlock","target":"self","resolver":"reaction.reversalOrDefenseFollowup","conditions":[{"kind":"sameOpponentAsBlockedAttack"}]}]},"DDB-RIT-CORE-011":{"name":"Witness Statement in Crayon","effects":[{"id":"reaction-witness-statement-second-attack","effect":"core.custom","trigger":"onAttackDeclared","target":"opponent","amount":-2,"resolver":"reaction.secondNormalAttackPenaltyAndInitiateDraw","conditions":[{"kind":"incomingAttackTargetsSelf"},{"kind":"attackNumber","operator":"eq","value":2},{"kind":"currentAttackIsNormal"}]}]},"DDB-RIT-CORE-012":{"name":"X-Ray Paper","effects":[{"id":"reaction-x-ray-paper-zero-damage","effect":"core.custom","trigger":"onAttackDeclared","target":"self","amount":0,"resolver":"reaction.preventIncomingDamage","conditions":[{"kind":"incomingAttackTargetsSelf"}]}]}}}
