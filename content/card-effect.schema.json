{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nullableninja.github.io/dojo-deckbuilder/schema/card-effect.schema.json",
  "title": "Dojo Deckbuilder Structured Card Effect",
  "description": "Machine-readable executable card effect. Family authoring sources should reference content/effects.json through the effect field. The generator expands references into runtime-compatible action metadata; printed rules text remains presentation text.",
  "type": "object",
  "required": ["trigger"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable effect-instance identifier unique within the card."
    },
    "effect": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[A-Za-z][A-Za-z0-9]*$",
      "description": "Stable canonical semantic effect ID from content/effects.json. Family authoring sources should prefer this field."
    },
    "trigger": {
      "enum": [
        "onPlay",
        "onHit",
        "onBlock",
        "afterResolve",
        "onEquip",
        "onPurchase",
        "onInitiate",
        "onHide",
        "onAttackDeclared",
        "onDefenseDeclared",
        "passive"
      ]
    },
    "action": {
      "enum": [
        "draw",
        "discard",
        "heal",
        "gainFocus",
        "modifySpeed",
        "modifyAttackPower",
        "modifyGuard",
        "dealDamage",
        "piercing",
        "destroy",
        "ready",
        "exhaust",
        "preventDamage",
        "chooseZone",
        "custom"
      ],
      "description": "Runtime action. May be omitted in family authoring sources when effect references content/effects.json; the generator will hydrate it."
    },
    "target": {
      "enum": ["self", "opponent", "source", "chosen-card", "chosen-equipment"],
      "description": "Affected entity. May be supplied by the effect vocabulary's default target when omitted."
    },
    "amount": {
      "type": "number"
    },
    "duration": {
      "enum": ["immediate", "nextAttack", "nextDefense", "endOfTurn", "endOfRound", "nextHonor", "whileEquipped"]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "operator": {
            "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "includes", "notIncludes"]
          },
          "value": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "array", "items": { "type": "string" } },
              { "type": "array", "items": { "type": "number" } }
            ]
          }
        }
      },
      "default": []
    },
    "resolver": {
      "type": "string",
      "minLength": 1,
      "description": "Named dedicated resolver for complex effects. Required when the hydrated action is custom or when the vocabulary marks the effect resolver-required."
    }
  },
  "anyOf": [
    { "required": ["effect"] },
    { "required": ["action"] }
  ],
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "custom" } }, "required": ["action"] },
      "then": { "required": ["resolver"] }
    }
  ]
}
