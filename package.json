{
  "name": "dojo-deckbuilder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/verify-card-inspector-bundle.mjs",
    "preview": "vite preview",
    "game:generate": "node scripts/generate-game-data.mjs",
    "game:check": "node scripts/check-generated-game-data.mjs",
    "engine:local": "node engine/cli.mjs local",
    "engine:ai": "node engine/cli.mjs ai",
    "simulate": "node engine/simulate.mjs",
    "test": "node --experimental-strip-types --test tests/engine.test.mjs tests/structured-effects.test.mjs tests/rules-json-runtime.test.mjs tests/quick-duel-character-coach-modification-host.test.mjs tests/quick-duel-character-damage-incoming-host.test.mjs tests/quick-duel-character-equip-host.test.mjs",
    "verify": "npm run game:generate && npm run game:check && git diff --exit-code -- content/card-effects.json app/data && npm test && npm run build"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
